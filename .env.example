# LLM Provider Configuration
# Set which provider to use: OPEN_AI, ANTHROPIC, or GEMINI
LLM_PROVIDER=OPEN_AI

# API Keys for different providers (only add the key for your chosen provider)
# --- OpenAI ---
# Format: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# --- Anthropic ---
# Format: sk-ant-xxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get from: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Gemini ---
# Format: No specific format, typically alphanumeric
# Get from: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key

# Optional: Specify models for each provider
# If not provided, defaults will be used:
# - OPEN_AI: gpt-6-astra
# - ANTHROPIC: claude-opus-5-5
# - GEMINI: gemini-2.5-pro
# OPENAI_MODEL=gpt-6.1-sol
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_MODEL=gemini-3.1-pro-preview

# Optional: Maximum tokens the LLM may write per review request (default: 8192)
# Raise it if reviews fail with "The review was cut off"
# LLM_MAX_TOKENS=8192

# Optional: Large codebases are split into parts of ~100K characters and each
# part is reviewed with its own LLM request. This caps the number of parts
# (and API calls); skipped parts are reported in the review summary. (default: 5)
# REVIEW_MAX_PARTS=5
